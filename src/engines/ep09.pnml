/* EP09 switches */
// graphics
switch(FEAT_TRAINS, SELF, switch_ep09_graphics, train_is_driving_backwards) {
    1: return sset_ep09_rev;
    return sset_ep09;
}
switch(FEAT_TRAINS, SELF, switch_ep09_pkp_ic_graphics, train_is_driving_backwards) {
    1: return sset_ep09_pkp_ic_rev;
    return sset_ep09_pkp_ic;
}
switch(FEAT_TRAINS, SELF, switch_ep09_pkp_cargo_graphics, train_is_driving_backwards) {
    1: return sset_ep09_pkp_cargo_rev;
    return sset_ep09_pkp_cargo;
}
switch(FEAT_TRAINS, SELF, switch_ep09_pkp_zp_graphics, train_is_driving_backwards) {
    1: return sset_ep09_pkp_zp_rev;
    return sset_ep09_pkp_zp;
}
switch(FEAT_TRAINS, SELF, switch_ep09_pkp_olkol_graphics, train_is_driving_backwards) {
    1: return sset_ep09_pkp_olkol_rev;
    return sset_ep09_pkp_olkol;
}
switch(FEAT_TRAINS, SELF, switch_ep09_db_graphics, train_is_driving_backwards) {
    1: return sset_ep09_db_rev;
    return sset_ep09_db;
}
switch(FEAT_TRAINS, SELF, switch_ep09_db_P5_graphics, train_is_driving_backwards) {
    1: return sset_ep09_db_P5_rev;
    return sset_ep09_db_P5;
}
switch(FEAT_TRAINS, SELF, switch_ep09_016_graphics, train_is_driving_backwards) {
    1: return sset_ep09_016_rev;
    return sset_ep09_016;
}
switch(FEAT_TRAINS, SELF, switch_ep09_pkp_ic_old_graphics, train_is_driving_backwards) {
    1: return sset_ep09_pkp_ic_old_rev;
    return sset_ep09_pkp_ic_old;
}
switch(FEAT_TRAINS, SELF, switch_ep09_046_graphics, train_is_driving_backwards) {
    1: return sset_ep09_046_rev;
    return sset_ep09_046;
}
switch(FEAT_TRAINS, SELF, switch_ep09_026_graphics, train_is_driving_backwards) {
    1: return sset_ep09_026_rev;
    return sset_ep09_026;
}
switch(FEAT_TRAINS, SELF, switch_ep09_026_rodzyn_graphics, train_is_driving_backwards) {
    1: return sset_ep09_026_rodzyn_rev;
    return sset_ep09_026_rodzyn;
}
switch(FEAT_TRAINS, SELF, switch_ep09_classic_graphics, train_is_driving_backwards) {
    1: return sset_ep09_classic_rev;
    return sset_ep09_classic;
}
switch(FEAT_TRAINS, SELF, switch_ep09_022_odkryj_graphics, train_is_driving_backwards) {
    1: return sset_ep09_022_odkryj_rev;
    return sset_ep09_022_odkryj;
}
// other
switch(FEAT_TRAINS, SELF, switch_ep09_articulated, extra_callback_info1) {
    1: return item_dummy_1;        // dummy parts
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch(FEAT_TRAINS, SELF, switch_ep09_visual_effect_local, position_in_vehid_chain % 2) {
    0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}
switch (FEAT_TRAINS, SELF, switch_ep09_add_text, IS_HEATING_CLIMATE ) {
    1: return string(STR_PURCHASE_DESCR_2L, string(STR_HEATING_ELECTRIC_POWER_TEXT, HEATING_POWER_ELECTRIC_HI), string(STR_ENGINE_EXPRESS));
    return string(STR_ENGINE_EXPRESS);
}
ENGINE_RUNNING_COST_SWITCH(ep09, EP09)
DIESEL_ELECTRIC_2_ENGINE_POWER_SWITCH(ep09, KW_TO_HP(2920))
ENGINE_VISUAL_EFFECT_SWITCH(ep09)

switch(FEAT_TRAINS, SELF, switch_ep09_can_attach, vehicle_type_id) {
    item_twindexx:   return string(STR_ATTACH_DISALLOW, string(STR_EP09_NAME));
    item_twindexxcc: return string(STR_ATTACH_DISALLOW, string(STR_EP09_NAME));
    return switch_normal_can_attach;
}

/* Define the actual train */
item(FEAT_TRAINS, item_ep09, 780) {
    property {
        /* common properties */
        name:                           string(STR_EP09_NAME);
        variant_group:                  792;
        climates_available:             PKP_CLIMATES; 
        introduction_date:              date(1990, 1, 1);
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        reliability_decay:              20;
        CARGO_LOCOMOTIVES_DEFINITION
        loading_speed:                  5; 
        cost_factor:                    PURCHASE_COST_EP09;
        running_cost_factor:            RUNNING_COST_EP09;
        /* train properties */
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          160 km/h;
        misc_flags:                     bitmask();
        refit_cost:                     0;
        track_type:                     ELRL;
        ai_special_flag:                AI_FLAG_CARGO;
        power:                          2920 kW;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        dual_headed:                    0;
        ENGINE_CAPACITY_REFIT_PROPERTY
        weight:                         84 ton;
        ai_engine_rank:                 0; // not intended to be used by the ai
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        extra_power_per_wagon:          0 kW;
        tractive_effort_coefficient:    0.236638998106888;
        air_drag_coefficient:           0.07;
        length:                         8;
        extra_weight_per_wagon:         0;
        visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_DEFAULT, 0, DISABLE_WAGON_POWER);
        bitmask_vehicle_info:           0;
    }

    graphics {
        purchase:                   sset_ep09_purchase;
        additional_text:            switch_ep09_add_text;
        default:                    switch_ep09_graphics;
        articulated_part:           switch_ep09_articulated;
        visual_effect_and_powered:  switch_ep09_visual_effect;
        can_attach_wagon:           switch_ep09_can_attach;
        start_stop:                 switch_normal_start_stop;
        ENGINE_CAPACITY_REFIT_CALLBACKS
        ENGINE_RUNNING_COST_CALLBACKS(ep09)
        ENGINE_POWER_CALLBACKS(ep09)
    }
}
