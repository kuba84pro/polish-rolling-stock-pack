// 27we switches
switch(FEAT_TRAINS, SELF, switch_27we_articulated, getbits(extra_callback_info1, 0, 8)) {
    1..10: return item_27we;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch(FEAT_TRAINS, SELF, switch_27we_length, position_in_vehid_chain % 11) {
    1: return 3;    // dummy parts
    3: return 1;    // dummy parts
    5: return 1;    // dummy parts
    7: return 1;    // dummy parts
    9: return 2;    // dummy parts
    return 8;
}
switch(FEAT_TRAINS, SELF, switch_27we_graphics, position_in_vehid_chain % 11) {
    0: return sgroup_27we_head;
    2: return sgroup_27we_mid;
    4: return sgroup_27we_mid;
    6: return sgroup_27we_mid;
    8: return sgroup_27we_mid;
    10: return sgroup_27we_tail;
    return sset_dummy;      // dummy parts
}
switch(FEAT_TRAINS, SELF, switch_27we_capacity, position_in_vehid_chain % 11) {
    0: return 32;
    2: return 32;
    4: return 33;
    6: return 33;
    8: return 32;
    10: return 32;
    return 1;   // dummy parts
}
switch(FEAT_TRAINS, SELF, switch_27we_visual_effect_local, position_in_vehid_chain % 11) {
    0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 3, DISABLE_WAGON_POWER);
    10: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}
switch (FEAT_TRAINS, SELF, switch_27we_add_text, IS_HEATING_CLIMATE ) {
    1: return string(STR_PURCHASE_DESCR_3L, string(STR_HEATING_ELECTRIC_TEXT), string(STR_6PART_EMU_TEXT), string(STR_INCOME_LOWER_LOADING_FASTER));
    return string(STR_PURCHASE_DESCR_2L, string(STR_6PART_EMU_TEXT), string(STR_INCOME_LOWER_LOADING_FASTER));
}
switch (FEAT_TRAINS, SELF, switch_27we_start_stop, COUNT_ELF_1 > 1) {
    1: return string(STR_TRAIN_TOO_LONG, string(STR_27WE_NAME));
    return CB_RESULT_NO_TEXT;
}

ENGINE_RUNNING_COST_SWITCH(27we, 27WE)
DIESEL_ELECTRIC_2_ENGINE_POWER_SWITCH(27we, KW_TO_HP(3200))
ENGINE_VISUAL_EFFECT_SWITCH(27we)

/* Define the actual train */
item(FEAT_TRAINS, item_27we, 2410) {
    property {
        /* common properties */
        name:                           string(STR_27WE_NAME);
        variant_group:                  2399;
        climates_available:             PKP_CLIMATES; 
        introduction_date:              date(2010, 1, 1);
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        reliability_decay:              20;
        CARGO_PASSENGERS_WAGON_DEFINITION
        loading_speed:                  21+5;     // per part
        cost_factor:                    PURCHASE_COST_27WE;
        running_cost_factor:            RUNNING_COST_27WE;
        cargo_age_period:               int(185*0.84);  // faster ageing
        /* train properties */
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          160 km/h;
        misc_flags:                     bitmask();
        refit_cost:                     0;
        track_type:                     ELRL;
        ai_special_flag:                AI_FLAG_PASSENGER;
        power:                          3200 kW;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        dual_headed:                    0;
        cargo_capacity:                 1;
        weight:                         190 ton;
        ai_engine_rank:                 0; // not intended to be used by the ai
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        extra_power_per_wagon:          0 kW;
        tractive_effort_coefficient:    0.1434;
        air_drag_coefficient:           0.07;
        length:                         8;
        extra_weight_per_wagon:         0;
        visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_DEFAULT, 0, DISABLE_WAGON_POWER);
        bitmask_vehicle_info:           bitmask(VINFO_PASSENGER_WAGON);
    }

    graphics {
        purchase:                   sset_27we_purchase;
        default:                    switch_27we_graphics;
        articulated_part:           switch_27we_articulated;
        additional_text:            switch_27we_add_text;
        length:                     switch_27we_length;
        purchase_cargo_capacity:    return 194/11;
        cargo_capacity:             switch_27we_capacity;
        visual_effect_and_powered:  switch_27we_visual_effect;
        can_attach_wagon:           switch_elf1_can_attach;
        start_stop:                 switch_27we_start_stop;
        ENGINE_RUNNING_COST_CALLBACKS(27we)
        ENGINE_POWER_CALLBACKS(27we)
    }
}

